service wukong-system-powerd /system/bin/wukong-system-powerd
    class late_start
    disabled
    user root
    group system everybody
    capabilities DAC_OVERRIDE DAC_READ_SEARCH FOWNER
    socket wukong_system_power stream 0660 system everybody u:object_r:wukong_system_power_socket:s0
    restart_period 5

on property:sys.boot_completed=1
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy2/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy5/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chown system system /sys/class/kgsl/kgsl-3d0/max_gpuclk
    chmod 0660 /sys/class/kgsl/kgsl-3d0/max_gpuclk
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0660 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    start wukong-system-powerd
