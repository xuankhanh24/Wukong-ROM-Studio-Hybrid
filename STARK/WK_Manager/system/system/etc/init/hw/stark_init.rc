+on post-fs-data
+    # Wukong Manager read-only GPU metric sysfs access.
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/gpuclk
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/clock_mhz
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/temp
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/clock_mhz
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/cur_freq
+
+on property:vendor.post_boot.parsed=1
+    # Re-apply after vendor post-boot scripts finish.
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/gpuclk
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/clock_mhz
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/temp
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/clock_mhz
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/cur_freq
+
+on property:sys.boot_completed=1
+    # Re-apply once sysfs nodes are fully registered.
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/gpuclk
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/clock_mhz
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/devfreq/cur_freq
+    chmod 0444 /sys/class/kgsl/kgsl-3d0/temp
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/clock_mhz
+    chmod 0444 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/cur_freq
