+on post-fs-data
+    # wk needs init context for readonly boot property updates; make sure
+    # /system/bin/wk is packed with u:object_r:wk_exec:s0.
+
+    # Verified Boot state
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.verifiedbootstate green
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.veritymode enforcing
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.device_state locked
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.flash.locked 1
+
+    # Secure boot state
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.secureboot.lockstate locked
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.secureboot.devicelock 1
+
+    # Bootloader identity
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.bootloader OP5D2BL1-locked
+
+    # System security flags
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.secure 1
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.debuggable 0
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.adb.secure 1
+
+    # Build tags
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.build.tags release-keys
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.build.type user
+
+    # Attestation props
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.product.brand_for_attestation OnePlus
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.product.manufacturer_for_attestation OnePlus
+
+    # VBMETA props
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.digest {{VBMETA_BLOB_HASH}}
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.hash_alg sha256
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.size 2368
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.avb_version 1.3
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.invalidate_on_error yes
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.vbmeta.device /dev/block/by-name/vbmeta_a
+
+    # Additional boot params
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.force_normal_boot 1
+    exec u:r:init:s0 root root -- /system/bin/wk -n ro.boot.slot_suffix _a
+
+    # Vendor sync
+    exec u:r:init:s0 root root -- /system/bin/wk -n vendor.boot.verifiedbootstate green
+    exec u:r:init:s0 root root -- /system/bin/wk -n vendor.boot.vbmeta.device_state locked
+    exec u:r:init:s0 root root -- /system/bin/wk -n vendor.boot.vbmeta.digest {{VBMETA_BLOB_HASH}}