    <version>9999123199</version>
    <filter-name>sys_cpulimit_config</filter-name>
    <versionCode>1.0</versionCode>
    <cpuSetConfig enable="false" version="">
        <groupConfig Level="1" L_bg="2-3" H_BG="0-4"/>
        <groupConfig Level="2" L_bg="1-3" H_BG="0-5"/>
        <cpuThreshold Low="90" High="98"/>
    </cpuSetConfig>
    <!--
    platform       - getprop from ro.soc.model
    Lbg            - Low background cgroup cpus
    Hbg            - High background cgroup cpus
    ExendedBg      - extend background cpus if little cores highload
    ExcludeProduct - disable for this product
    -->
    <cpuSetSwitch>
        <!-- Qcom Soc Platform -->
        <switchConfig Platform="SM8650" Lbg="0-1" Hbg="0-1,5-6" ExendedBg="0-1,4-6" ExcludeProduct="" />
        <switchConfig Platform="SM8750" Lbg="0-3" Hbg="0-5" ExendedBg="0-5" ExcludeProduct="" />
        <switchConfig Platform="SM8850" Lbg="0-3" Hbg="0-5" ExendedBg="0-5" ExcludeProduct="" />
        <!-- Mtk Soc Platform -->
        <switchConfig Platform="MT6985" Lbg="2-3" Hbg="0-4" ExendedBg="0-4" ExcludeProduct="" />
        <switchConfig Platform="MT6989" Lbg="2-3" Hbg="0-4" ExendedBg="0-4" ExcludeProduct="" />
        <switchConfig Platform="MT6991" Lbg="2-3" Hbg="0-4" ExendedBg="0-4" ExcludeProduct="" />
        <switchConfig Platform="MT6993" Lbg="2-3" Hbg="0-4" ExendedBg="0-4" ExcludeProduct="" />
    </cpuSetSwitch>
