    <vip_HBG enable="false">
       <pkg name="com.tencent.mm" />
       <pkg name="com.tencent.mobileqq" />
    </vip_HBG>
    <particularPkg enable="true">
       <pkg name="com.oplus.camera" />
    </particularPkg>
    <cpuHighLoadCfg enable="true">
        <loadThreshold Low="80" High="95"/>
        <availableMem AvailMemValue="800"/>
        <bigDataCfg enable="false" TriggerThreshold="95" onlyPreVersion="true"/>
        <instantLoadCfg enable="true" TimeOut="5000"/>
        <knReport ReportInterval="1" ReportThreshold = "80"/>
        <windowLength WinLen="5" ShortWinLen="3"/>
        <thermalThreshold Low="7" High="10"/>
        <loadForThermal Low="80" High="90"/>
        <dStateTime Threshold="30"/>
        <mngLevelCtrlRetrigger IntervalTime="5000" LimitCount="0" />
        <continuousHighLoadCntRec IntervalTime="20000" LimitCount="10" />
        <processList>
            <memProcName>kswapd0</memProcName>
            <memProcName>hybridswapd:0</memProcName>
            <memProcName>kshrink_slabd</memProcName>
            <systemProcName>system_server</systemProcName>
            <systemProcName>surfaceflinger</systemProcName>
        </processList>
        <expectedHighLoadScene enable="false">
            <pkg name = "com.oplus.camera" />
        </expectedHighLoadScene>
    </cpuHighLoadCfg>
    <dex2oatCpusetCfg enable="true">
        <groupConfig compileReason="install" sensScene="gps|audio|video|call|game" minGroup="0" maxGroup="2"/>
        <groupConfig compileReason="bg-dexopt" sensScene="gps|audio|video|call" minGroup="0" maxGroup="2"/>
        <groupConfig compileReason="inactive" sensScene="gps|audio|video|call|game" minGroup="0" maxGroup="2"/>
        <groupConfig compileReason="shared" sensScene="gps|audio|video|call|game" minGroup="1" maxGroup="3"/>
        <dex2oatImpBgPkg enable="true">
            <pkg name="com.coloros.backuprestore" />
            <pkg name="com.heytap.market" />
            <pkg name="com.android.packageinstaller" />
            <pkg name="com.oplus.appdetail" />
            <pkg name="com.google.android.packageinstaller" />
