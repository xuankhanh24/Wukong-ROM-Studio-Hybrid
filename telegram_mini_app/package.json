    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "framer-motion": "13.2.0",
    "lucide-react": "1.45.0",
    "matter-js": "0.20.0",
    "motion": "13.2.0",
    "prism-react-renderer": "2.4.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
